{
  "name": "dsh-session-id",
  "version": "0.1.0",
  "description": "DSH Web UI surface: show each Session row's short id and copy the full one",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hn5092/deepseek_plugin.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "session",
    "id"
  ],
  "license": "MIT"
}
